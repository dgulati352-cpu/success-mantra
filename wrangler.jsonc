{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "success-mantra-api",
  "main": "worker/index.js",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "R2_BUCKET_NAME": "success-mantra",
    "R2_PUBLIC_URL": "",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "success-mantra-d1",
      "database_id": "6d2f282b-f4eb-4cb6-ac7d-fc3e8e6d30ff",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "success-mantra"
    }
  ],
  "observability": {
    "enabled": true
  }
}
